#!/bin/sh /etc/rc.common
# UVC webcams -> MJPEG over HTTP. Settings: /etc/config/cams (LuCI: Services -> Webcams)
START=99
USE_PROCD=1
HASHF=/tmp/cams.streamhash
LISTF=/tmp/cams.list

# hash of everything that needs a stream restart (not brightness etc.)
stream_hash() {
  /usr/sbin/cams-list | cut -d'|' -f1-7 | md5sum | cut -d' ' -f1
}

service_triggers() {
  procd_add_reload_trigger cams
}

boot() {
  (
    cut -d. -f1 /proc/uptime > /tmp/cams.lock
    n=0
    while [ "$n" -lt 40 ] && ! ls /sys/class/video4linux/video* >/dev/null 2>&1; do
      sleep 1; n=$((n + 1))
    done
    sleep 3
    try=0
    while [ "$try" -lt 4 ]; do
      /etc/init.d/cams stop >/dev/null 2>&1
      killall mjpg_streamer >/dev/null 2>&1
      sleep 2
      /etc/init.d/cams start
      sleep 12
      /usr/sbin/cams-check && break
      logger -t cams "start attempt $try failed, retrying"
      try=$((try + 1))
    done
    rm -f /tmp/cams.lock
  ) &
}

start_service() {
  /usr/sbin/cams-sync
  /usr/sbin/cams-list > "$LISTF"
  while IFS='|' read -r dev sec port user pass res fps rest; do
    out="output_http.so -p $port"
    [ -n "$user" ] && out="$out -c $user:$pass"
    procd_open_instance "cam$port"
    procd_set_param command /usr/bin/mjpg_streamer \
      -i "input_uvc.so -d $dev -r $res -f $fps -y -n" \
      -o "$out"
    procd_set_param respawn
    procd_close_instance
  done < "$LISTF"
  stream_hash > "$HASHF"
  ( sleep 8; /usr/sbin/cams-apply ) &
}

reload_service() {
  /usr/sbin/cams-sync
  if [ "$(stream_hash)" = "$(cat "$HASHF" 2>/dev/null)" ]; then
    /usr/sbin/cams-apply &
  else
    stop
    start
  fi
}
