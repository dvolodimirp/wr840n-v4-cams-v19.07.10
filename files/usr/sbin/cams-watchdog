#!/bin/sh
# cron, every minute: restart the streams if a camera stopped delivering frames
LOCK=/tmp/cams.lock
now=$(cut -d. -f1 /proc/uptime)
if [ -f "$LOCK" ]; then
  t=$(cat "$LOCK" 2>/dev/null)
  [ -n "$t" ] && [ $((now - t)) -ge 0 ] && [ $((now - t)) -lt 300 ] && exit 0
fi
ls /sys/class/video4linux/video* >/dev/null 2>&1 || exit 0
/usr/sbin/cams-check && exit 0
echo "$now" > "$LOCK"
logger -t cams-watchdog "no frame from a camera, restarting streams"
/etc/init.d/cams stop >/dev/null 2>&1
killall mjpg_streamer >/dev/null 2>&1
sleep 2
/etc/init.d/cams start
sleep 15
rm -f "$LOCK"
